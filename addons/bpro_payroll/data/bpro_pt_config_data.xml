<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Seed data researched 2026-08-11 via current web sources (bankbazaar,
        factohr, chhotacfo, cleartax, saachihrms, greythr — see chat/memory
        for the search results this was built from). All four states are
        flagged for verification against the current state gazette
        notification before go-live; PT rates change periodically and this
        is a snapshot, not a live feed.
    -->

    <!-- ================= KARNATAKA (monthly) ================= -->
    <!-- Exemption threshold raised 15,000 -> 25,000 effective 1 Apr 2025
         (Karnataka PT Amendment Act 2025). Above 25,000: Rs.200/month,
         Rs.300 in February, totalling Rs.2,500/year (the constitutional
         cap). Source: multiple 2026 summaries agree on Feb as the topup
         month, but this is the single least-certain date in this file -
         verify before go-live. -->
    <record id="pt_config_karnataka" model="bpro.pt.config">
        <field name="name">Karnataka</field>
        <field name="state_id" ref="base.state_in_ka"/>
        <field name="periodicity">monthly</field>
        <field name="note">Verify current slab against the Karnataka
            Professional Tax gazette before go-live. Threshold raised
            15,000 to 25,000 effective 1 April 2025 - if the client has
            been running payroll on the old 15,000 threshold, this will
            change deductions for anyone between 15,000 and 24,999.
        </field>
    </record>
    <record id="pt_slab_ka_1" model="bpro.pt.slab.line">
        <field name="config_id" ref="pt_config_karnataka"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">24999</field>
        <field name="amount">0</field>
    </record>
    <record id="pt_slab_ka_2" model="bpro.pt.slab.line">
        <field name="config_id" ref="pt_config_karnataka"/>
        <field name="lower_bound">25000</field>
        <field name="upper_bound">0</field>
        <field name="amount">200</field>
        <field name="topup_month">2</field>
        <field name="topup_amount">300</field>
    </record>

