<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Seed data researched 2026-08-11 (ezhrm, source-cross-checked against
        the general "LWF deduct in December, remit by 31 Jan" pattern that
        applies across Karnataka/TN/AP/Telangana). All flat annual amounts,
        no income slabs - one unbounded slab line per state. Verify against
        the current state notification before go-live.

        Kerala seeded 2026-08-12, cross-checked against two independent
        sources (greythr, factohr) that agree exactly: the Kerala Labour
        Welfare Fund Act, 1975 (factories, plantations, and other
        establishments not covered by the separate 2006 Shops Act) charges
        Rs.45 employee + Rs.45 employer, half-yearly, contributed 30 June
        and 31 December, returns filed 15 July and 15 January. This is the
        1975 Act table, NOT the Kerala Shops and Commercial Establishments
        Workers Welfare Fund Act 2006 (which is Rs.50/Rs.50 monthly and
        covers shops/commercial establishments, not factories) - confirmed
        against ME Polymers' own registration as a manufacturer at Edathala
        Grama Panchayat, Aluva, so the 1975 Act is the correct table for
        this client specifically. Still verify against the current LWF
        Board notification before go-live for any other client, since the
        rate can change and a different client's establishment type may
        fall under the 2006 Act instead - add or edit a bpro.lwf.config via
        Settings > HR > Configuration > "Labour Welfare Fund States" (no
        code change needed) if so.
    -->

    <record id="lwf_config_kerala" model="bpro.lwf.config">
        <field name="name">Kerala</field>
        <field name="state_id" ref="base.state_in_kl"/>
        <field name="periodicity">half_yearly</field>
        <field name="charge_month_h1">6</field>
        <field name="charge_month_h2">12</field>
        <field name="note">Kerala Labour Welfare Fund Act, 1975 (factories/
            plantations/other establishments) - Rs.45 employee + Rs.45
            employer, contributed 30 June and 31 December, filed 15 July
            and 15 January. Applies to any establishment with 1+ employee.
            NOT the same as the Kerala Shops and Commercial Establishments
            Workers Welfare Fund Act 2006 (Rs.50/Rs.50 monthly) - if this
            client is a shop/commercial establishment rather than a
            factory, this config is the wrong one; add a separate
            half_yearly-vs-monthly config for that Act instead. Sourced
            2026-08-12 from greythr and factohr (cross-checked, both agree
            exactly) - verify against the current LWF Board notification
            before go-live.
        </field>
    </record>
    <record id="lwf_slab_kl_1" model="bpro.lwf.slab.line">
        <field name="config_id" ref="lwf_config_kerala"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">0</field>
        <field name="employee_amount">45</field>
        <field name="employer_amount">45</field>
    </record>

    <record id="lwf_config_karnataka" model="bpro.lwf.config">
        <field name="name">Karnataka</field>
        <field name="state_id" ref="base.state_in_ka"/>
        <field name="periodicity">annual</field>
        <field name="charge_month_h1">12</field>
        <field name="note">Deduction 31 December, deposit deadline 15
            January. Applicability threshold cut from 50 employees to 10,
            effective 7 January 2026 - confirm the client's Karnataka
            headcount meets this. Verify against the current Karnataka LWF
            notification before go-live.
        </field>
    </record>
    <record id="lwf_slab_ka_1" model="bpro.lwf.slab.line">
        <field name="config_id" ref="lwf_config_karnataka"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">0</field>
        <field name="employee_amount">50</field>
        <field name="employer_amount">100</field>
    </record>

    <record id="lwf_config_tamil_nadu" model="bpro.lwf.config">
        <field name="name">Tamil Nadu</field>
        <field name="state_id" ref="base.state_in_tn"/>
        <field name="periodicity">annual</field>
        <field name="charge_month_h1">12</field>
        <field name="note">Deposit deadline 31 January; deduction assumed
            December in line with the general AP/KA/TN/Telangana pattern.
            Verify against the current Tamil Nadu LWF notification before
            go-live.
        </field>
    </record>
    <record id="lwf_slab_tn_1" model="bpro.lwf.slab.line">
        <field name="config_id" ref="lwf_config_tamil_nadu"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">0</field>
        <field name="employee_amount">20</field>
        <field name="employer_amount">40</field>
    </record>

    <record id="lwf_config_andhra_pradesh" model="bpro.lwf.config">
        <field name="name">Andhra Pradesh</field>
        <field name="state_id" ref="base.state_in_ap"/>
        <field name="periodicity">annual</field>
        <field name="charge_month_h1">12</field>
        <field name="note">Deposit deadline 31 January; deduction assumed
            December in line with the general AP/KA/TN/Telangana pattern.
            Applicability is dual-threshold in AP: factories are covered
            regardless of employee count, shops/commercial establishments
            need 20+ employees - confirm the client's establishment type
            meets this before assuming LWF applies. Verify against the
            current Andhra Pradesh LWF notification before go-live.
        </field>
    </record>
    <record id="lwf_slab_ap_1" model="bpro.lwf.slab.line">
        <field name="config_id" ref="lwf_config_andhra_pradesh"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">0</field>
        <field name="employee_amount">30</field>
        <field name="employer_amount">70</field>
    </record>

    <!-- ================= TELANGANA (annual) ================= -->
    <!-- Telangana Labour Welfare Fund Act - same rate as AP
         (retained after the 2014 bifurcation). Cross-checked 2026-08-25
         against greythr. Deduction in December, deposit by 31 January.
         Verify against the Telangana LWF Board notification before
         go-live; the state may diverge from AP rates in future
         notifications. -->
    <record id="lwf_config_telangana" model="bpro.lwf.config">
        <field name="name">Telangana</field>
        <field name="state_id" ref="base.state_in_tg"/>
        <field name="periodicity">annual</field>
        <field name="charge_month_h1">12</field>
        <field name="note">Same rate as Andhra Pradesh - Telangana retained
            AP's LWF schedule after the 2014 bifurcation. Verify against
            the Telangana LWF Board notification before go-live; the state
            may diverge from AP's rates in future notifications.
        </field>
    </record>
    <record id="lwf_slab_tg_1" model="bpro.lwf.slab.line">
        <field name="config_id" ref="lwf_config_telangana"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">0</field>
        <field name="employee_amount">30</field>
        <field name="employer_amount">70</field>
    </record>

    <!-- ================= MAHARASHTRA (half-yearly) ================= -->
    <!-- Maharashtra Labour Welfare Fund Act 1953.
         Deduction and remittance twice a year: June 30 and December 31.
         Rates per contribution period (half-year): EE Rs.25, ER Rs.75.
         Cross-checked 2026-08-25 against greythr and factohr (both
         agree on Rs.25/Rs.75 per half-year). Applies to establishments
         with 5+ employees. Verify against the current Maharashtra LWF
         notification before go-live; the monthly variant (Rs.6+Rs.12)
         sometimes appears in older sources - the half-yearly Rs.25+Rs.75
         is the current rate. -->
    <record id="lwf_config_maharashtra" model="bpro.lwf.config">
        <field name="name">Maharashtra</field>
        <field name="state_id" ref="base.state_in_mh"/>
        <field name="periodicity">half_yearly</field>
        <field name="charge_month_h1">6</field>
        <field name="charge_month_h2">12</field>
        <field name="note">Maharashtra Labour Welfare Fund Act 1953.
            Applicable to establishments with 5+ employees. Deduction and
            remittance 30 June and 31 December. Some older sources cite a
            monthly Rs.6+Rs.12 rate - the current half-yearly Rs.25+Rs.75
            is what the Act currently specifies; verify before go-live.
        </field>
    </record>
    <record id="lwf_slab_mh_1" model="bpro.lwf.slab.line">
        <field name="config_id" ref="lwf_config_maharashtra"/>
        <field name="lower_bound">0</field>
        <field name="upper_bound">0</field>
        <field name="employee_amount">25</field>
        <field name="employer_amount">75</field>
    </record>

</odoo>
