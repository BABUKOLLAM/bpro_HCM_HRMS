<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_company_view_form_bpro_recruitment" model="ir.ui.view">
        <field name="name">res.company.form.bpro.recruitment</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Recruitment — Onboarding" name="bpro_recruitment_onboarding">
                    <group>
                        <field name="joining_report_sla"/>
                    </group>
                </page>
                <page string="WhatsApp Notifications" name="bpro_whatsapp">
                    <group string="Provider">
                        <field name="whatsapp_provider"/>
                        <field name="whatsapp_from_phone"
                               attrs="{'invisible': [('whatsapp_provider', '=', 'none')]}"/>
                        <field name="whatsapp_api_token" password="True"
                               attrs="{'invisible': [('whatsapp_provider', '=', 'none')]}"/>
                        <field name="whatsapp_meta_phone_number_id"
                               attrs="{'invisible': [('whatsapp_provider', '!=', 'meta')]}"/>
                    </group>
                    <p class="text-muted"
                       attrs="{'invisible': [('whatsapp_provider', '!=', 'none')]}">
                        Set a provider above to enable WhatsApp notifications for
                        offer delivery and interview scheduling alongside the
                        existing email channel. Contact your WhatsApp Business API
                        vendor (Meta, Twilio, or Gupshup) for credentials.
                    </p>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
