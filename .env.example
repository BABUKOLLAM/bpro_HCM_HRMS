COMPOSE_PROJECT_NAME=bpro_hrms_acme
# standalone = this stack runs its own Caddy on :80/:443
# shared-caddy = join an existing Caddy network/alias instead
DEPLOY_MODE=standalone
ODOO_ADMIN_PASSWD=replace-with-a-strong-unique-password
# Use a unique database name per production instance/client.
ODOO_DB_NAME=acme_hrms_prod
# Optional: defaults to ^<ODOO_DB_NAME>$
# ODOO_DBFILTER=^acme_hrms_prod$

# Required when DEPLOY_MODE=standalone
# Use the real public domain for this specific instance.
APP_DOMAIN=hrms.acme.example

# Required when DEPLOY_MODE=shared-caddy
# SHARED_CADDY_NETWORK=replace-with-existing-caddy-network
# ODOO_SHARED_ALIAS=replace-with-unique-odoo-alias
