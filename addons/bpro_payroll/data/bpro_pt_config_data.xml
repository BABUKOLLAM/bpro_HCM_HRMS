    <!-- ================= MAHARASHTRA (monthly) ================= -->
    <!-- Maharashtra PT slabs, FY 2025-26 rates cross-checked 2026-08-25
         against cleartax and greythr (both agree). Upper threshold for
         nil slab: Rs.7,500. Topup month is February (Rs.300 instead of
         Rs.200, totalling Rs.2,500/year for the top band). Note: women
         earning up to Rs.10,000/month are exempt in Maharashtra - same
         caveat as WB, confirm workforce composition before go-live. -->
    <record id="pt_config_maharashtra" model="bpro.pt.config">
        <field name="name">Maharashtra</field>
        <field name="state_id" ref="base.state_in_mh"/>
        <field name="periodicity">monthly</field>
        <field name="note">Women earning up to Rs.10,000/month are exempt
            from PT in Maharashtra - if the client has female employees
            in the Rs.7,501-10,000 band, they should NOT have PT applied.
            This module does not distinguish by gender; HR should manually
            exclude those employees using the PT State field (leave blank).
            Verify current slabs against the Maharashtra PT gazette before
            go-live.
        </field>
    </record>
