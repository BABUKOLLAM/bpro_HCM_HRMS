<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="bpro_employee_asset_view_form" model="ir.ui.view">
        <field name="name">bpro.employee.asset.form</field>
        <field name="model">bpro.employee.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_returned" string="Mark Returned" type="object"
                            invisible="state != 'issued'" class="oe_highlight"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="issued,returned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="name"/>
                            <field name="asset_type"/>
                            <field name="serial_tag"/>
                        </group>
                        <group>
                            <field name="issued_date"/>
                            <field name="returned_date" readonly="1" invisible="not returned_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bpro_employee_asset_view_list" model="ir.ui.view">
        <field name="name">bpro.employee.asset.list</field>
        <field name="model">bpro.employee.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="asset_type"/>
                <field name="serial_tag"/>
                <field name="issued_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="bpro_employee_asset_view_search" model="ir.ui.view">
        <field name="name">bpro.employee.asset.search</field>
        <field name="model">bpro.employee.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="name"/>
                <filter name="issued" string="Issued" domain="[('state', '=', 'issued')]"/>
                <separator/>
                <filter name="filter_issued_date" string="Issued On" date="issued_date"/>
                <filter name="filter_returned_date" string="Returned On" date="returned_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_type" string="Asset Type" context="{'group_by': 'asset_type'}"/>
                    <filter name="group_by_issued_date" string="Issued On" context="{'group_by': 'issued_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bpro_employee_asset" model="ir.actions.act_window">
        <field name="name">Employee Assets</field>
        <field name="res_model">bpro.employee.asset</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_issued': 1}</field>
    </record>

    <menuitem id="menu_bpro_employee_asset" name="Employee Assets"
              parent="hr_recruitment.menu_hr_recruitment_root"
              action="action_bpro_employee_asset" sequence="4"/>

</odoo>
