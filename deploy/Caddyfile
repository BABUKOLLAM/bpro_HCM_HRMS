# Reverse proxy + automatic HTTPS for both programmes hosted on this VPS.
# Caddy obtains and renews Let's Encrypt certificates automatically -
# no certbot, no manual renewal cron.
#
# TWO SEPARATE PROGRAMMES on this server:
#   1. bpro HCM/HRMS  → www.bprohrms.com   (container: odoo,         ports 8069/8072)
#   2. FieldOpsPro    → www.fieldopspro.in  (container: fieldops-odoo, ports 8079/8082)
#
# Requires each domain's DNS A/AAAA record to point at this server's IP,
# and ports 80+443 reachable from the internet (port 80 is needed for the
# ACME HTTP-01 challenge even though all traffic redirects to 443 afterwards).

# ---------------------------------------------------------------------------
# Programme 1: bpro HCM / HRMS
# ---------------------------------------------------------------------------

# Naked-domain redirect → always use www
bprohrms.com {
	redir https://www.bprohrms.com{uri} permanent
}

www.bprohrms.com {
	# Long-polling (Odoo's live chatter/notification bus) needs a
	# longer read timeout than Caddy's default, or it gets cut off
	# and silently reconnects more often than it should.
	reverse_proxy odoo:8069 {
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 610s
		}
	}

	# The bus/longpolling endpoint specifically talks to Odoo's
	# separate longpolling port (8072) - route it there, everything
	# else goes to the main app port above.
	handle /websocket/* {
		reverse_proxy odoo:8072
	}
	handle /longpolling/* {
		reverse_proxy odoo:8072
	}

	encode gzip

	log {
		output file /var/log/caddy/hcm-access.log
	}
}

# ---------------------------------------------------------------------------
# Programme 2: FieldOpsPro
# Container name: fieldops-odoo   (separate Docker Compose stack)
# Internal ports: 8079 (main app) · 8082 (longpolling/websocket)
# ---------------------------------------------------------------------------

# Naked-domain redirect → always use www
fieldopspro.in {
	redir https://www.fieldopspro.in{uri} permanent
}

www.fieldopspro.in {
	reverse_proxy fieldops-odoo:8079 {
		header_up X-Forwarded-Proto {scheme}
		transport http {
			read_timeout 610s
		}
	}

	handle /websocket/* {
		reverse_proxy fieldops-odoo:8082
	}
	handle /longpolling/* {
		reverse_proxy fieldops-odoo:8082
	}

	encode gzip

	log {
		output file /var/log/caddy/fieldopspro-access.log
	}
}
