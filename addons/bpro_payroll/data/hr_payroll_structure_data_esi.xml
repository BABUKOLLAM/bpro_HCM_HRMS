<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        ESI wage base is GROSS + OT (total wages including overtime).
        The eligibility threshold test uses GROSS only - overtime is
        statutorily excluded from the initial eligibility test but IS
        part of the contribution base once the employee qualifies.
        The contribution-period continuity check is via
        payslip.bpro_esi_period_eligible(categories.GROSS): once an
        employee is covered at the start of April or October, they
        stay covered through the full half-year even if a mid-period
        raise pushes their gross over the threshold that month.
        Sequenced 78-79, after the OT block (71) and PF block (72-77)
        and before NET (80) so ESI_EE lands in categories.DED.
    -->

    <record id="rule_esi_ee" model="hr.salary.rule">
        <field name="name">ESI (Employee)</field>
        <field name="code">ESI_EE</field>
        <field name="sequence" eval="78"/>
        <field name="category_id" ref="salary_rule_category_esi_ee"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.esi_applicable and payslip.bpro_esi_period_eligible(categories.GROSS)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = (categories.GROSS + categories.OT) * (contract.company_id.esi_employee_rate / 100.0)</field>
    </record>

    <record id="rule_esi_er" model="hr.salary.rule">
        <field name="name">ESI (Employer)</field>
        <field name="code">ESI_ER</field>
        <field name="sequence" eval="79"/>
        <field name="category_id" ref="salary_rule_category_esi_er"/>
        <field name="condition_select">python</field>
        <field name="condition_python">result = contract.esi_applicable and payslip.bpro_esi_period_eligible(categories.GROSS)</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = (categories.GROSS + categories.OT) * (contract.company_id.esi_employer_rate / 100.0)</field>
    </record>

    <record id="structure_india_ctc" model="hr.payroll.structure">
        <field name="rule_ids" eval="[(4, ref('rule_esi_ee')), (4, ref('rule_esi_er'))]"/>
    </record>

</odoo>
