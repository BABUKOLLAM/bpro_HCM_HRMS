<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="bpro_exit_request_view_form" model="ir.ui.view">
        <field name="name">bpro.exit.request.form</field>
        <field name="model">bpro.exit.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_accept" string="Accept Resignation" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"
                            groups="bpro_base.group_client_hr"/>
                    <button name="action_compute_settlement" string="Compute Settlement" type="object"
                            invisible="state not in ('accepted', 'settled')"
                            groups="bpro_base.group_client_hr"/>
                    <button name="action_settle" string="Settle" type="object"
                            invisible="state != 'accepted'" class="oe_highlight"
                            groups="bpro_base.group_client_hr"/>
                    <button name="action_close" string="Close (Register Departure)" type="object"
                            invisible="state != 'settled'" class="oe_highlight"
                            groups="bpro_base.group_client_hr"
                            confirm="This archives the employee and deactivates their login - it is the final offboarding step. Continue?"/>
                    <button name="%(action_report_fnf_statement)d" string="Print F&amp;F Statement" type="action"
                            invisible="not settlement_computed"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,accepted,settled,closed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="1"/>
                            <field name="resignation_date" readonly="state != 'draft'"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="notice_days" readonly="state not in ('draft', 'submitted')"/>
                            <field name="accepted_date" readonly="1" invisible="not accepted_date"/>
                            <field name="last_working_day"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clearance" name="clearance">
                            <field name="clearance_line_ids" readonly="state in ('settled', 'closed')">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="line_type"/>
                                    <field name="note"/>
                                    <field name="state" readonly="1"/>
                                    <field name="done_by" readonly="1"/>
                                    <field name="done_date" readonly="1"/>
                                    <button name="action_mark_done" string="Mark Done" type="object"
                                            invisible="state == 'done'"/>
                                </list>
                            </field>
                            <field name="clearance_done" invisible="1"/>
                        </page>
                        <page string="Settlement (F&amp;F)" name="settlement">
                            <group>
                                <group string="Basis">
                                    <field name="service_start_date"/>
                                    <field name="monthly_basic" readonly="1"/>
                                    <field name="settlement_computed" invisible="1"/>
                                </group>
                                <group string="Payables">
                                    <field name="gratuity_years" readonly="1"/>
                                    <field name="gratuity_amount"/>
                                    <field name="el_balance_days" readonly="1"/>
                                    <field name="el_encashment_amount"/>
                                    <field name="other_addition"/>
                                </group>
                                <group string="Recoveries">
                                    <field name="notice_shortfall_days" readonly="1"/>
                                    <field name="notice_recovery_amount"/>
                                    <field name="other_deduction"/>
                                </group>
                                <group string="Total">
                                    <field name="settlement_total" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Exit Interview" name="exit_interview">
                            <group>
                                <field name="exit_interview_date"/>
                                <field name="exit_interview_by"/>
                                <field name="exit_interview_notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bpro_exit_request_view_list" model="ir.ui.view">
        <field name="name">bpro.exit.request.list</field>
        <field name="model">bpro.exit.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="resignation_date"/>
                <field name="last_working_day"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="bpro_exit_request_view_search" model="ir.ui.view">
        <field name="name">bpro.exit.request.search</field>
        <field name="model">bpro.exit.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter name="open" string="In Progress"
                        domain="[('state', 'in', ('submitted', 'accepted', 'settled'))]"/>
                <separator/>
                <filter name="filter_resignation_date" string="Resignation Date" date="resignation_date"/>
                <filter name="filter_last_working_day" string="Last Working Day" date="last_working_day"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_last_working_day" string="Last Working Day" context="{'group_by': 'last_working_day:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bpro_exit_request" model="ir.actions.act_window">
        <field name="name">Exit Requests</field>
        <field name="res_model">bpro.exit.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>

    <menuitem id="menu_bpro_exit_request" name="Exit / Separation"
              parent="hr.menu_hr_root"
              action="action_bpro_exit_request" sequence="25"/>

</odoo>
